# Copy to .env (git-ignored). Loaded by duosim at start-up; real environment variables win.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Extra OpenAI-compatible endpoints (OpenRouter, Groq, vLLM, Ollama ...), see docs/SAAS.md
# DUOSIM_PROVIDERS=[{"name": "local", "base_url": "http://127.0.0.1:11434/v1", "model": "llama3.2-vision", "vision": true}]
# Optional model overrides
# DUOSIM_GEMINI_MODEL=
# DUOSIM_CLAUDE_MODEL=

# FreeCAD worker the design service builds in (see docs/FREECAD_INTEGRATION.md)
# DUOSIM_FREECAD_URL=127.0.0.1:9875
# FREECAD_MCP_TOKEN=

# Keyless Studio for anonymous visitors, with small shared caps (see docs/PLATFORM.md)
# DUOSIM_PUBLIC_DEMO=1
# Local development only: no auth and no caps
# DUOSIM_DEV_OPEN=1

# ---- commercial SaaS (docs/SAAS.md)
# DUOSIM_PUBLIC_URL=https://app.example.com      # used in emailed links
# DUOSIM_SECRET_KEY=                              # >= 32 chars; encrypts workspace provider keys
# DUOSIM_ADMIN_EMAILS=you@example.com             # platform administrators
# DUOSIM_SIGNUP=open                              # open | invite | closed
# DUOSIM_REQUIRE_VERIFIED_EMAIL=1
# DUOSIM_SMTP_URL=smtp://user:pass@smtp.example.com:587
# DUOSIM_MAIL_FROM=DuoSim <no-reply@example.com>
# DUOSIM_COOKIE_SECURE=1                          # behind TLS
# DUOSIM_BILLING=stripe                           # stripe | mock (demo only) | unset = admin-managed
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# DUOSIM_STRIPE_PRICE_PRO=price_...
# DUOSIM_STRIPE_PRICE_TEAM=price_...
# DUOSIM_STRIPE_PRICE_PACK_500=price_...
# DUOSIM_STRIPE_PRICE_PACK_2000=price_...
# DUOSIM_CREDITS=1                                # 0 = no credit metering (self-hosted)
# DUOSIM_CREDIT_COSTS={"generate.deep": 12}
# DUOSIM_MAX_IMPORT_MB=50
