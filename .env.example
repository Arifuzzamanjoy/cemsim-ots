# Copy to .env (git-ignored). Loaded by cemsim at start-up; real environment variables win.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides
# CEMSIM_GEMINI_MODEL=
# CEMSIM_CLAUDE_MODEL=

# FreeCAD worker the design service builds in (see docs/FREECAD_INTEGRATION.md)
# CEMSIM_FREECAD_URL=127.0.0.1:9875
# FREECAD_MCP_TOKEN=

# Keyless Studio for anonymous visitors, with small shared caps (see docs/PLATFORM.md)
# CEMSIM_PUBLIC_DEMO=1
# Local development only: no auth and no caps
# CEMSIM_DEV_OPEN=1
